   "footer": {
    "slideNumber": true,
    "logo": false
   },
   "forbid": [
    "body",
    "g3"
   ],
   "note": "THE WORKHORSE. Columns carry a numeral AND a label — a rule with a label under it and no numeral reads as disconnected."
  },
  "L04": {
   "name": "Two-column contrast",
   "grounds": [
    "blue",
    "ink"
   ],
   "anchor": "top",
   "maxBlocks": 2,
   "slots": {
    "kicker": {
     "required": true,
     "maxWords": 4,
     "class": "k"
    },
    "columns": {
     "required": true,
     "count": 2,
     "class": "col2",
