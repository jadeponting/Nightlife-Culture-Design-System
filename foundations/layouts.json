 "movedFrom": "contracts/layouts.json",
 "movedNote": "Moved to foundations/ 16 Aug 2026, unchanged. This is the one thing the old generation held that the new one had never replaced: slot contracts, word limits, block budgets, permitted grounds and the vertical anchor per layout. The generated layouts obey the grid and the components; they do not yet obey these contracts. Wiring them into layouts/build_layouts.py and the validator is the next job, and until it is done a word limit here is recorded rather than enforced.",
 "classMapping": {
  "note": "The classes named in the slots are the OLD generation's — logo, t, brk, sub, tr3, g3. The generated layer uses nc-slogo, nc-t, nc-brk, nc-sub, nc-cols, nc-cells. The mapping is one-to-one and is what the wiring job has to write down.",
  "logo": "nc-slogo",
  "t": "nc-t",
  "brk": "nc-brk",
  "sub": "nc-sub",
  "body": "nc-sbody",
  "tr3": "nc-cols",
  "g3": "nc-cells",
  "pnum": "nc-snum"
 }
