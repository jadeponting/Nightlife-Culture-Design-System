{
 "$schema": "./layouts.schema.md",
 "version": "1.0",
 "source": "Nightlife Culture Style Guide v1.0 + slide-layouts.html",
 "howToUse": "Every <section> in a deck declares data-layout. The validator reads this file and checks the section against its contract. Do not add slots a layout does not declare — pick a different layout instead.",
 "layouts": {
  "L01": {
   "name": "Cover",
   "grounds": [
    "blue",
    "ink"
   ],
   "anchor": "two",
   "maxBlocks": 4,
   "slots": {
    "logo": {
     "required": true,
     "maxWords": 3,
     "class": "logo big"
    },
    "title": {
     "required": true,
     "maxWords": 6,
     "class": "t"
    },
    "breaker": {
     "required": true,
     "count": 1,
     "class": "brk"
    },
    "sub": {
     "required": false,
     "maxWords": 18,
     "class": "sub"
    }
   },
   "footer": {
    "slideNumber": false,
    "logo": false
   },
   "forbid": [
    "body",
    "tr3",
    "g3"
   ],
   "note": "The logo is the first block; the statement and stop rule anchor to the bottom. No slide number on a cover."
  },
  "L02": {
   "name": "Section divider",
   "grounds": [
    "blue",
    "ink"
   ],
   "anchor": "centre",
   "maxBlocks": 3,
   "slots": {
    "kicker": {
     "required": true,
     "maxWords": 4,
     "class": "k"
    },
    "title": {
     "required": true,
     "maxWords": 5,
     "class": "t xl"
    },
    "breaker": {
     "required": true,
     "count": 1,
     "class": "brk"
    }
   },
   "footer": {
    "slideNumber": true,
    "logo": true
   },
   "forbid": [
    "sub",
    "body",
    "tr3",
    "g3"
   ],
   "note": "Nothing follows the rule. That is what makes it a stop."
  },
  "L03": {
   "name": "Three points",
   "grounds": [
    "blue",
    "chalk",
    "white",
    "ink"
   ],
   "anchor": "two",
   "maxBlocks": 5,
   "slots": {
    "kicker": {
     "required": true,
     "maxWords": 4,
     "class": "k"
    },
    "title": {
     "required": true,
     "maxWords": 6,
     "class": "t"
    },
    "breaker": {
     "required": true,
     "count": 1,
     "class": "brk"
