    }
   },
   "footer": {
    "slideNumber": true,
    "logo": false
   },
   "forbid": [
    "title",
    "sub",
    "tr3",
    "g3"
   ],
   "note": "The second column title in teal marks the side you want heard. 6% gutter. One breaker per column is correct here — the global max of 1 does not apply. Anchored top because the two column bodies fill the frame; bottom-anchoring leaves a hole above them.",
   "maxBreakers": 2
  },
