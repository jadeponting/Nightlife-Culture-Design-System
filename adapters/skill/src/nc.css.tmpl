{{HEADER}}
{{TOKENS_ROOT}}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--chalk);color:var(--ink);font-family:var(--body);
font-size:16.5px;line-height:1.6;-webkit-font-smoothing:antialiased}
.wrap{max-width:1120px;margin:0 auto;padding:0 34px 120px}
h1,h2,h3,h4{margin:0}
.display{font-family:var(--display);text-transform:uppercase;letter-spacing:-.012em;line-height:.9}
p{margin:0 0 15px;max-width:76ch}
.lede{font-size:19px;line-height:1.5;max-width:70ch}
.note{font-size:13.5px;color:var(--charcoal);max-width:76ch}
ul,ol{margin:0 0 16px;padding-left:22px;max-width:76ch}
li{margin-bottom:8px}
a{color:var(--blue)}
code{font-family:ui-monospace,Menlo,monospace;font-size:.88em;background:var(--white);padding:1px 5px;outline:1px solid var(--hair)}

header{background:var(--blue);color:#fff;padding:78px 34px 66px}
header .inner{max-width:1120px;margin:0 auto}
header .lg{font-family:var(--display);text-transform:uppercase;font-size:20px;line-height:.9;letter-spacing:-.01em;margin-bottom:34px}
header .display{font-size:clamp(50px,8vw,104px)}
header .rule{height:10px;background:var(--teal);width:220px;margin:26px 0 30px}
header .meta{font-family:var(--head);font-weight:700;font-size:12.5px;letter-spacing:.16em;text-transform:uppercase;opacity:.9}

/* contents */
.toc{background:var(--white);outline:1px solid var(--hair);outline-offset:-1px;padding:28px 32px;margin-top:44px;border-top:9px solid var(--teal)}
.toc h2{font-family:var(--head);font-weight:800;text-transform:uppercase;font-size:15px;letter-spacing:.08em;margin-bottom:16px}
.toc ol{columns:2;column-gap:44px;padding-left:0;list-style:none;max-width:none;margin:0}
.toc li{margin-bottom:9px;font-size:14.5px;break-inside:avoid}
.toc a{text-decoration:none;font-weight:500}
.toc a:hover{text-decoration:underline}
.toc .n{font-family:var(--head);font-weight:800;font-size:12px;letter-spacing:.06em;color:var(--charcoal);margin-right:9px}

/* sections */
section{padding-top:74px}
h2.sec{display:flex;align-items:center;gap:15px;border-bottom:3px solid var(--ink);padding-bottom:12px;margin-bottom:26px;
       font-family:var(--head);font-weight:800;text-transform:uppercase;font-size:27px;letter-spacing:.02em;line-height:1}
h2.sec .n{font-family:var(--head);font-weight:800;font-size:15px;letter-spacing:.04em;background:var(--ink);
  color:var(--chalk);padding:6px 9px;line-height:1;display:flex;align-items:center;height:28px;flex:none}
h3.sub{font-family:var(--head);font-weight:800;text-transform:uppercase;font-size:17px;letter-spacing:.05em;margin:36px 0 13px}
h4.sub2{font-family:var(--head);font-weight:700;font-size:15px;margin:24px 0 9px}

.q{border-left:12px solid var(--pink);padding:6px 0 6px 22px;margin:26px 0;
   font-family:var(--head);font-weight:800;font-size:21px;line-height:1.28;max-width:44ch}
.box{background:var(--white);outline:1px solid var(--hair);outline-offset:-1px;padding:24px 26px;margin:22px 0;border-top:9px solid var(--teal)}
.box.blue{background:var(--blue);color:#fff;outline:none;border-top-color:var(--pink)}
.box.blue p,.box.blue li{color:#fff}
.box h4{font-family:var(--head);font-weight:800;text-transform:uppercase;font-size:14px;letter-spacing:.07em;margin-bottom:11px}

/* ---- TABLES · default = Editorial ---- */
table{border-collapse:collapse;width:100%;font-size:14px;background:transparent;margin:18px 0 22px}
th,td{padding:11px 14px 11px 0;text-align:left;vertical-align:top;
  border-bottom:1px solid rgba(13,13,13,.13)}
th{font-family:var(--head);font-weight:700;text-transform:uppercase;font-size:10.5px;letter-spacing:.12em;
  color:var(--charcoal);background:transparent;border-bottom:2.5px solid var(--ink);padding-bottom:9px}
tbody tr:last-child td{border-bottom:1px solid rgba(13,13,13,.13)}
td.n{font-family:ui-monospace,Menlo,monospace;font-size:13px;text-align:right;white-space:nowrap;padding-right:0}
table td:last-child,table th:last-child{padding-right:0}

/* ---- table variants ---- */
.t-chalk th{background:var(--chalk);color:var(--ink);border-bottom:1px solid rgba(13,13,13,.20);padding:10px 14px}
.t-chalk td{padding:11px 14px}
.t-chalk{background:var(--white);outline:1px solid rgba(13,13,13,.13)}
.t-accent{border-top:7px solid var(--teal)}
.t-accent th{border-bottom:1px solid rgba(13,13,13,.20);padding-top:12px}
.t-ink th{background:var(--ink);color:var(--chalk);padding:10px 14px;border-bottom:none;font-weight:800}
.t-ink td{padding:11px 14px}
.t-ink{background:var(--white);outline:1px solid rgba(13,13,13,.13)}
.t-band tbody tr:nth-child(odd){background:rgba(13,13,13,.035)}
.t-band th,.t-band td{padding:10px 14px}
.t-band td{border-bottom:none}
.t-band th{border-bottom:2.5px solid var(--ink)}
.t-blue th{background:var(--blue);color:#fff;padding:10px 14px;border-bottom:none;font-weight:800}
.t-blue td{padding:11px 14px}
.t-blue{background:var(--white);outline:1px solid rgba(13,13,13,.13)}
.tdemo{margin:0 0 8px}
.tdemo table{margin:0}
.tlab{font-family:var(--head);font-weight:800;text-transform:uppercase;font-size:12px;letter-spacing:.08em;margin:26px 0 10px}
.tnote{font-size:12.5px;color:var(--charcoal);margin:8px 0 0;max-width:70ch}

/* ---- charts ---- */
.ch{background:var(--white);outline:1px solid var(--hair);outline-offset:-1px;padding:22px 24px 20px;border-top:8px solid var(--blue)}
.ch.pk{border-top-color:var(--pink)}.ch.tl{border-top-color:var(--teal)}
.ch.bt{border-top-color:var(--butter)}.ch.vt{border-top-color:var(--violet)}
.ch .ct{font-family:var(--head);font-weight:800;text-transform:uppercase;font-size:13.5px;letter-spacing:.05em;line-height:1.15}
.ch .cs{font-size:12.5px;color:var(--charcoal);margin-top:5px;margin-bottom:20px}
.ev{margin-top:18px;padding-top:12px;border-top:1px solid var(--hair);font-size:11.5px;line-height:1.5;color:var(--charcoal)}
.ev b{font-family:var(--head);font-weight:800;letter-spacing:.05em;text-transform:uppercase;font-size:10px;color:var(--ink)}
.cgrid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:20px 0}
.cgrid.one{grid-template-columns:1fr}
.bar{display:flex;align-items:center;gap:12px;margin-bottom:10px}
.bar .lb{font-size:12.5px;width:104px;flex:none;font-weight:500}
.bar .tkk{flex:1;height:24px;position:relative;background:var(--chalk)}
.bar .fl{position:absolute;left:0;top:0;bottom:0}
.bar .vl{font-family:ui-monospace,Menlo,monospace;font-size:12px;width:44px;text-align:right;flex:none}
.hatch{background-image:repeating-linear-gradient(45deg,rgba(13,13,13,.30) 0 3px,transparent 3px 7px);
  background-color:var(--chalk);outline:1px solid var(--hair);outline-offset:-1px}
.dp .row{display:flex;align-items:center;gap:12px;margin-bottom:13px}
.dp .lb{font-size:12.5px;width:104px;flex:none;font-weight:500}
.dp .tk2{flex:1;height:22px;position:relative;border-bottom:1px solid rgba(13,13,13,.12)}
.dp .rng{position:absolute;top:9px;height:4px;background:rgba(0,0,255,.20)}
.dp .pt{position:absolute;top:4px;width:14px;height:14px;transform:translateX(-7px);border:2px solid var(--white);background:var(--blue)}
.dp .vl{font-family:ui-monospace,Menlo,monospace;font-size:12px;width:48px;text-align:right;flex:none}
.axis{display:flex;margin-left:116px;margin-right:60px;font-family:ui-monospace,Menlo,monospace;font-size:10.5px;color:var(--charcoal);justify-content:space-between}
.dwrap{display:flex;gap:20px;align-items:center;flex-wrap:wrap}
.ring{width:150px;height:150px;border-radius:50%;flex:none;position:relative;
  background:conic-gradient(var(--c1) 0 41%,var(--c2) 41% 68%,var(--c3) 68% 87%,var(--c4) 87% 100%)}
.hole{position:absolute;inset:31%;background:var(--white);border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center}
.hole .n{font-family:var(--display);font-size:17px;line-height:1}
.hole .l{font-family:var(--head);font-weight:800;font-size:8px;letter-spacing:.1em;text-transform:uppercase;margin-top:3px}
.key{flex:1;min-width:160px}
.key div{display:flex;align-items:center;gap:9px;font-size:12.5px;margin-bottom:9px}
.key i{width:15px;height:15px;flex:none;outline:1px solid var(--hair);display:block}
.key b{font-family:ui-monospace,Menlo,monospace;font-weight:400;margin-left:auto}
.stk{display:flex;height:42px;margin-bottom:10px;outline:1px solid var(--hair);outline-offset:-1px}
.stk div{display:flex;align-items:center;justify-content:center;font-family:var(--head);font-weight:800;font-size:11.5px}
.stkkey{display:flex;flex-wrap:wrap;gap:14px;font-size:12px;margin-top:14px}
.stkkey span{display:flex;align-items:center;gap:7px}
.stkkey i{width:14px;height:14px;display:block;outline:1px solid var(--hair)}
svg.line{width:100%;height:auto;display:block}
svg.line text{font-family:"Archivo";font-weight:800}
.ramp{display:flex;margin:16px 0 8px;outline:1px solid var(--hair)}
.ramp div{flex:1;height:64px;display:flex;align-items:flex-end;justify-content:center;padding-bottom:7px;
  font-family:var(--head);font-weight:700;font-size:10.5px;letter-spacing:.03em}
.prov{display:inline-block;font-family:var(--head);font-weight:800;font-size:9.5px;letter-spacing:.09em;
  padding:3px 7px;background:var(--ink);color:#fff;margin:0 6px 6px 0}
.prov.mid{background:var(--butter);color:var(--ink)}.prov.warn{background:var(--coral);color:var(--ink)}
.meter{display:flex;gap:5px;margin:4px 0 8px}
.meter span{flex:1;height:15px;background:var(--chalk);outline:1px solid var(--hair);outline-offset:-1px}
.mlab{display:flex;justify-content:space-between;font-size:10.5px;color:var(--charcoal);font-family:var(--head);font-weight:600;letter-spacing:.04em;text-transform:uppercase}

/* ---- stat blocks ---- */
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:18px;margin:22px 0}
.st{background:var(--white);outline:1px solid var(--hair);outline-offset:-1px;padding:20px 22px;border-left:10px solid var(--blue)}
.st.acc-pink{border-left-color:var(--pink)}
.st.acc-teal{border-left-color:var(--teal)}
.st.acc-butter{border-left-color:var(--butter)}
.st.acc-coral{border-left-color:var(--coral)}
.st .big{font-family:var(--display);font-size:40px;line-height:.9;letter-spacing:-.02em}
.st .lb{font-family:var(--head);font-weight:800;font-size:10.5px;text-transform:uppercase;letter-spacing:.1em;margin-top:10px;line-height:1.3}
.st .src{font-size:11px;color:var(--charcoal);margin-top:8px;line-height:1.4}
.st2{background:var(--white);outline:1px solid var(--hair);outline-offset:-1px;padding:20px 22px;border-top:9px solid var(--teal)}
.st2 .big{font-family:var(--display);font-size:40px;line-height:.9;color:var(--blue)}
.stfill{padding:20px 22px;background:var(--teal)}
.stfill .big{font-family:var(--display);font-size:40px;line-height:.9}
.sw{display:inline-block;width:14px;height:14px;outline:1px solid var(--hair);vertical-align:-2px;margin-right:8px}

/* palette */
.pal{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:16px;margin:22px 0}
.tk{outline:1px solid var(--hair);outline-offset:-1px;background:var(--white)}
.tk .c{height:112px;display:flex;align-items:flex-end;padding:12px}
.tk .c b{font-family:var(--head);font-weight:800;font-size:14px;letter-spacing:.04em}
.tk .m{padding:13px}
.tk .m .nm{font-family:var(--head);font-weight:800;text-transform:uppercase;font-size:13px;letter-spacing:.06em;margin-bottom:5px}
.tk .m .r{font-size:12.5px;line-height:1.42;color:var(--charcoal)}
.tk .m .t{font-size:10.5px;margin-top:9px;padding-top:8px;border-top:1px solid rgba(13,13,13,.12);
  font-family:var(--head);font-weight:700;letter-spacing:.05em;color:var(--charcoal)}

/* type scale */
.ts{background:var(--white);outline:1px solid var(--hair);outline-offset:-1px;padding:22px 24px;margin-bottom:14px}
.ts .lab{font-family:var(--head);font-weight:600;font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--charcoal);margin-bottom:12px}

/* containment demo */
.cont{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px;margin:20px 0}
.cd{background:var(--chalk);padding:20px}
.cd .p{padding:15px 17px}
.cd .p .l{font-family:var(--head);font-weight:800;text-transform:uppercase;font-size:11.5px;letter-spacing:.05em}
.cd .cap{font-size:12px;color:var(--charcoal);margin-top:11px;line-height:1.4}

/* slides */
.slides{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin:22px 0}
.slide{aspect-ratio:16/9;position:relative;overflow:hidden;container-type:inline-size;outline:1px solid rgba(13,13,13,.18)}
.cv{position:absolute;inset:0}
.pad{position:absolute;left:6%;right:6%;top:7.5%;bottom:14%;display:flex;flex-direction:column}
.foot{position:absolute;left:6%;right:6%;bottom:5.5%;display:flex;justify-content:space-between;align-items:flex-end}
/* Slide logo slot — holds the PLACED outlined wordmark (assets/nightlife-culture-wordmark.svg,
   fill=currentColor). Never re-set the wordmark as live type: NIGHTLIFE and CULTURE carry
   different sizes and per-line tracking, which no font-size + letter-spacing pair reproduces. */
.cv .logo{width:11cqw}
.cv .logo svg{display:block;width:100%;height:auto}
.cv .pnum{font-family:var(--head);font-weight:800;font-size:1.25cqw;letter-spacing:.08em}
.cv .k{font-family:var(--head);font-weight:800;font-size:1.3cqw;letter-spacing:.2em;text-transform:uppercase}
.cv .t{font-family:var(--display);text-transform:uppercase;font-size:5.2cqw;line-height:.92}
.cv .sub{font-family:var(--head);font-weight:800;font-size:1.9cqw;line-height:1.32;max-width:64%}
.cv .brk{height:.42cqw;width:20%}
.scap{font-size:12.5px;color:var(--charcoal);margin-top:9px;font-family:var(--head);font-weight:600}

/* charts */
.bar{display:flex;align-items:center;gap:12px;margin-bottom:10px}
.bar .lb{font-size:12.5px;width:110px;flex:none;font-weight:500}
.bar .tkk{flex:1;height:24px;position:relative;background:var(--chalk)}
.bar .fl{position:absolute;left:0;top:0;bottom:0}
.bar .vl{font-family:ui-monospace,Menlo,monospace;font-size:12px;width:44px;text-align:right;flex:none}
.ramp{display:flex;margin:16px 0 8px;outline:1px solid var(--hair)}
.ramp div{flex:1;height:64px;display:flex;align-items:flex-end;justify-content:center;padding-bottom:7px;
  font-family:var(--head);font-weight:700;font-size:10.5px;letter-spacing:.03em}
.prov{display:inline-block;font-family:var(--head);font-weight:800;font-size:9.5px;letter-spacing:.09em;
  padding:3px 7px;background:var(--ink);color:#fff;margin:0 6px 6px 0}
.prov.mid{background:var(--butter);color:var(--ink)}.prov.warn{background:var(--coral);color:var(--ink)}
.gap{background:var(--white);outline:1px solid var(--hair);outline-offset:-1px;padding:22px 26px;margin:22px 0;border-left:12px solid var(--coral)}
@media(max-width:880px){.slides{grid-template-columns:1fr}.toc ol{columns:1}.wrap{padding:0 20px 80px}}
@media print{header{background:#0000FF !important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
 body{background:#fff}section{page-break-inside:auto}h2.sec{page-break-after:avoid}}

/* ---- v1.1 additions · containment classes from references/components.md ---- */
/* Fill panel — accent background set via token (e.g. style="background:var(--violet)");
   text stays ink per the accent rule. No border. Needs generous surrounding space. */
.pnl{padding:24px 26px;margin:26px 0}
/* Left-rule callout — white panel, 12px accent bar on left, for callouts and asides
   (pull quotes remain .q). Default blue, mirroring .st; same acc-* modifiers. */
.callq{background:var(--white);outline:1px solid var(--hair);outline-offset:-1px;
  padding:22px 26px;margin:22px 0;border-left:12px solid var(--blue)}
.callq.acc-pink{border-left-color:var(--pink)}
.callq.acc-teal{border-left-color:var(--teal)}
.callq.acc-butter{border-left-color:var(--butter)}
.callq.acc-coral{border-left-color:var(--coral)}
/* Hairline utility — 1px ink at 22%. White panels on chalk, tables, forms.
   Never for anything carrying meaning. */
.hair{outline:1px solid var(--hair);outline-offset:-1px}

